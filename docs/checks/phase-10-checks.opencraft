label = "Volume"

[profile.pages.bindings.knob-1.turn-right.settings.functions.left]
kind = "opencraft.volume"

[profile.pages.bindings.knob-1.turn-right.settings.functions.left.settings]
operation = "down"
step = 5

[profile.pages.bindings.knob-1.turn-right.settings.functions.right]
kind = "opencraft.volume"

[profile.pages.bindings.knob-1.turn-right.settings.functions.right.settings]
operation = "up"
step = 5

[[profile.pages.bindings.knob-1.turn-right.settings.functions]]
label = "Brightness"

[profile.pages.bindings.knob-1.turn-right.settings.functions.left]
kind = "opencraft.device-brightness"

[profile.pages.bindings.knob-1.turn-right.settings.functions.left.settings]
