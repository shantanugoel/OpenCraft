[profile.pages.surfaces.key-face-1]
color = "#2D333B"
label = "Press only"

[profile.pages.surfaces.key-face-2]
color = "#1F6FEB"
label = "Gestures"

[profile.pages.surfaces.key-face-3]
color = "#2D333B"
icon = "mic-off"
label = "PTT Off"

[profile.pages.surfaces.key-face-3.on]
color = "#DA3633"
icon = "mic"
label = "PTT Live"

[profile.pages.surfaces.key-face-4]
color = "#1F6FEB"
label = "Focus"

[profile.pages.surfaces.key-face-4.on]
color = "#2EA043"
label = "Break"

[profile.pages.surfaces.key-face-5]
color = "#8957E5"
icon = "repeat"
label = "Cycle"

[profile.pages.surfaces.key-face-6]
color = "#D29922"
icon = "timer"
label = "Timer"
