[[profile.pages]]
name = "3 System"

[profile.pages.bindings.key-1.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-1.press.settings]
function = "mission-control"

[profile.pages.bindings.key-10.press]
kind = "opencraft.page"

[profile.pages.bindings.key-10.press.settings]
show_number = true
target = "next"

[profile.pages.bindings.key-2.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-2.press.settings]
function = "show-desktop"

[profile.pages.bindings.key-3.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-3.press.settings]
function = "launchpad"

[profile.pages.bindings.key-4.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-4.press.settings]
function = "screenshot"

[profile.pages.bindings.key-5.press]
kind = "opencraft.sequence"

[profile.pages.bindings.key-5.press.settings]
delay_ms = 100

[[profile.pages.bindings.key-5.press.settings.actions]]
kind = "opencraft.type-text"

[profile.pages.bindings.key-5.press.settings.actions.settings]
delay_before_ms = 0
paste = false
return_after = false
text = "1"

[[profile.pages.bindings.key-5.press.settings.actions]]
kind = "opencraft.type-text"

[profile.pages.bindings.key-5.press.settings.actions.settings]
delay_before_ms = 1500
paste = false
return_after = false
text = "2"

[[profile.pages.bindings.key-5.press.settings.actions]]
kind = "opencraft.type-text"

[profile.pages.bindings.key-5.press.settings.actions.settings]
delay_before_ms = 300
paste = false
return_after = false
text = "3"

[profile.pages.bindings.key-6.press]
kind = "opencraft.device-brightness"

[profile.pages.bindings.key-6.press.settings]
operation = "set"
value = 80

[profile.pages.bindings.key-7.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-7.press.settings]
function = "screen-saver"

[profile.pages.bindings.key-8.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-8.press.settings]
function = "lock"

[profile.pages.bindings.key-9.press]
kind = "opencraft.mac-function"

[profile.pages.bindings.key-9.press.settings]
function = "sleep"

